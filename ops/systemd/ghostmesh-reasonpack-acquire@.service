[Unit]
Description=GhostMesh ReasonPack contained acquisition job %i
Documentation=https://github.com/pinklon/reasonpack/issues/8
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=ghostmesh
Group=ghostmesh
# + runs only this pinned, reviewed, fixed-argument root-owned claim helper.
# The helper consumes an owner-only ledger slot before any user worker starts.
ExecStartPre=+/usr/bin/python3 @IMMUTABLE_RELEASE_DIR@/ops/acquisition-owner-prestart.py --job-id %i
ExecStart=/usr/bin/python3 @IMMUTABLE_RELEASE_DIR@/ops/acquisition-cgroup-runner.py --job-id %i
WorkingDirectory=@IMMUTABLE_RELEASE_DIR@
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=no
KillMode=control-group
KillSignal=SIGTERM
FinalKillSignal=SIGKILL
SendSIGKILL=yes
TimeoutStartSec=infinity
TimeoutStopSec=45s
RuntimeMaxSec=infinity
OOMPolicy=stop
MemoryMax=8G
TasksMax=128
CPUQuota=200%
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
ReadWritePaths=/srv/ghostmesh/workspaces/runs/reasonpack-jobs/%i

[Install]
WantedBy=multi-user.target
